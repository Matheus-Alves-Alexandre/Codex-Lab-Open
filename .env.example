# Optional: copy to .env.local or run npm run setup:firebase.
# Leave Firebase fields empty for catalog-only mode. VITE_* values are public.
PORT=3000
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
# For local emulators: set PROJECT_ID=demo-codex-lab and EMULATORS=true.
VITE_FIREBASE_EMULATORS=false
